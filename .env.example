# Токен Telegram-бота (получить у @BotFather)
BOT_TOKEN=

# Токен Crypto Pay API (@CryptoBot -> Crypto Pay -> My Apps)
CRYPTOBOT_TOKEN=
CRYPTOBOT_API=https://pay.crypt.bot/api

# Telegram ID администраторов (через запятую)
ADMIN_IDS=

# Валюта инвойсов CryptoBot (fiat)
CURRENCY=RUB

# Публичный HTTPS-адрес мини-аппа
WEBAPP_URL=

# Порт локального сервера
PORT=8877

# DEV_MODE=1 — демо-админ в браузере. Выключи (0) перед продом!
DEV_MODE=1
